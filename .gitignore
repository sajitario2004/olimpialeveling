# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.bin/

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
.pytest_cache/
server/.pytest_cache/
*.log

# Flutter & Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
.widget_preview/
.flutter-plugins
.flutter-plugins-dependencies
app/.dart_tool/
app/.packages
app/.pub-cache/
app/.pub/
app/build/
app/coverage/
app/.widget_preview/
app/.flutter-plugins
app/.flutter-plugins-dependencies

# Android
app/android/.gradle/
app/android/local.properties
app/android/**/GeneratedPluginRegistrant.java
app/android/captures/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/

# iOS & macOS Native Build Artifacts
app/ios/Pods/
app/ios/.symlinks/
app/ios/Flutter/Generated.xcconfig
app/ios/Flutter/flutter_export_environment.sh
app/ios/Flutter/.last_build_id
app/ios/Flutter/ephemeral/
app/ios/Flutter/Flutter.framework
app/ios/Flutter/Flutter.podspec
app/ios/Runner/GeneratedPluginRegistrant.h
app/ios/Runner/GeneratedPluginRegistrant.m
app/macos/Pods/
app/macos/.symlinks/
app/macos/Flutter/ephemeral/
app/macos/Flutter/Generated.xcconfig
app/macos/Flutter/flutter_export_environment.sh
app/macos/Flutter/.last_build_id
app/macos/Flutter/GeneratedPluginRegistrant.swift

# Xcode User Data & Schemes
xcuserdata/
*.xcscmblueprint

# SQLite & Test Databases
*.db-journal
*.db-wal
*.db-shm
app/*.db
app/*.db-journal
app/test/*.db
app/test/*.db-journal

# Environment & Sensitive Files
.env
.env.*
*.env

# IDEs & Editors
*.iml
*.ipr
*.iws
.idea/
.vscode/
*.swp
*.swo
*~
